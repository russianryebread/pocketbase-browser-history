{
  "manifest_version": 2,
  "name": "History to PocketBase",
  "version": "1.1.0",
  "description": "Sync Firefox browsing history to a PocketBase server you choose",
  "browser_specific_settings": {
    "gecko": {
      "id": "{be0bcc57-9f6d-4750-8363-6af089ce0bac}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "personallyIdentifyingInfo",
          "searchTerms"
        ]
      }
    }
  },
  "permissions": [
    "history",
    "storage",
    "alarms"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "History to PocketBase"
  },
  "optional_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
