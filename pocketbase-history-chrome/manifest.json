{
  "manifest_version": 3,
  "name": "History to PocketBase",
  "version": "1.0",
  "description": "Save browser history to PocketBase",
  "permissions": [
    "history",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "History to PocketBase"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
